<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="overhead_camera">
    <static>true</static>
    <pose>0 0 1.2  0 1.5708 0</pose>

    <link name="camera_link">
      <visual name="cam_vis">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient></material>
      </visual>

      <sensor name="conveyor_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.02</near><far>20</far></clip>
        </camera>

        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <always_publish>true</always_publish>
          <robotNamespace>/</robotNamespace>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
          <image_topic_name>image_raw</image_topic_name>
          <camera_info_topic_name>camera_info</camera_info_topic_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
